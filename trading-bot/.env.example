# Copy to .env and edit. Never commit .env.
BOT_PASSPHRASE=pick-a-long-random-secret   # same value as the Pine input "Webhook passphrase"
BOT_MODE=paper                             # paper = simulated, ccxt = real exchange orders
BOT_STARTING_CASH=10000

# Risk limits
BOT_RISK_PER_TRADE=0.01        # lose at most 1% of equity if the stop is hit
BOT_MAX_POSITION_PCT=0.25      # never put more than 25% of equity in one position
BOT_MAX_TRADES_PER_DAY=10
BOT_MAX_DAILY_LOSS_PCT=0.05    # stop opening trades after a 5% losing day
BOT_MIN_SCORE=4                # ignore alerts with a confluence score below this
BOT_ALLOWED_SYMBOLS=           # e.g. BTCUSDT,ETHUSDT  (blank = any)

# Only for BOT_MODE=ccxt  (pip install ccxt)
BOT_EXCHANGE=binance           # any ccxt id: binance, bybit, kraken, okx, ...
BOT_SANDBOX=true               # testnet first!
BOT_API_KEY=
BOT_API_SECRET=

# Optional Telegram trade notifications
BOT_TELEGRAM_TOKEN=
BOT_TELEGRAM_CHAT_ID=

# Trading desk data source: FYERS (live NSE/BSE) if set, otherwise Yahoo (delayed)
BOT_DATA_SOURCE=               # fyers | yahoo | blank = auto
FYERS_APP_ID=                  # e.g. ABCD1234-100
FYERS_ACCESS_TOKEN=            # regenerate daily via FYERS login

# Optional AI mentor (reads your chart screenshot): key from console.anthropic.com
ANTHROPIC_API_KEY=

# FYERS auto-trader (python -m adryn_bot.autotrader). Paper mode sends NO orders.
AUTO_MODE=paper                # paper | live  (live = real money orders on FYERS)
AUTO_SYMBOLS=RELIANCE.NS,HDFCBANK.NS,SBIN.NS
AUTO_STYLE=intraday            # intraday (15m) | scalping (5m)
AUTO_RR=2                      # 2 = 1:2 risk:reward, 3 = 1:3
AUTO_CAPITAL=100000
AUTO_RISK_PCT=0.5              # lose at most 0.5% of capital per trade
AUTO_MAX_TRADES=3              # per day
AUTO_MAX_DAILY_LOSS=1500       # stop taking trades after this loss
AUTO_START=09:30
AUTO_LAST_ENTRY=14:45
AUTO_SQUAREOFF=15:10
AUTO_ALLOW_SHORT=true
